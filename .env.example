# Copy this file to .env and replace every placeholder before starting Compose.
# Generate strong URL-safe values with: openssl rand -hex 32
POSTGRES_USER=cloudcart
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=cloudcart
DATABASE_SSL=false
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password
SEED_CUSTOMER_PASSWORD=replace-with-a-local-customer-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=cloudcart-api
CORS_ORIGIN=http://localhost:8080
FRONTEND_PORT=8080

# Redis is private to the Compose network and is configured by docker-compose.yml.
REDIS_PRODUCT_TTL_SECONDS=300
REDIS_CATEGORY_TTL_SECONDS=300
REDIS_PRODUCT_LIST_TTL_SECONDS=60

# Required for real SQS/SNS/S3-backed behavior. Prefer an EC2 instance role
# instead of storing AWS keys in .env.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PRESIGNED_URL_EXPIRES_IN=900
AWS_SQS_ORDER_QUEUE_URL=
AWS_SNS_ORDER_TOPIC_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
