aws_region     = "ap-south-1"
project_name   = "cloudcart"
environment    = "production"
frontend_origin = "https://frontend.example.com"

# Build and push immutable image tags before applying ECS resources.
backend_image = "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/cloudcart-backend:<IMAGE_TAG>"
worker_image  = "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/cloudcart-worker:<IMAGE_TAG>"
frontend_image = "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/cloudcart-frontend:<IMAGE_TAG>"

# Supply an ACM certificate ARN for HTTPS and HTTP-to-HTTPS redirect.
acm_certificate_arn = ""

# Leave empty to derive a globally unique name from account ID and region.
s3_bucket_name = ""

# RDS is disabled for the initial low-cost infrastructure deployment. Enable it
# before running database migrations or enabling the backend ECS service.
enable_rds = false

# Redis is optional; the backend runs with its existing no-cache behavior when disabled.
enable_redis = false

# The ALB is disabled for the initial low-cost infrastructure deployment.
enable_alb = false

enable_ecs_services = false

order_queue_name = "cloudcart-order-events"
order_topic_name = "cloudcart-order-events"